# Launchpad — the one-box install.
#
# install.sh writes this file with generated secrets and never rewrites it
# afterwards. It is here so you can see what it wrote, and edit it deliberately.
#
# BACK THIS FILE UP. ENCRYPTION_KEY below is the only thing that can decrypt
# this install's app secrets and git tokens. Losing it does not fail loudly —
# it makes every stored secret undecryptable, with no error that says so.
#
# After changing anything here:  docker compose up -d

# --- The image -------------------------------------------------------------

# Pinned, never `latest`. Migrations run at boot and are one-way, so a tag that
# moved under a restart would be an unannounced schema upgrade with no way back.
LAUNCHPAD_IMAGE=gopanair/launchpad
LAUNCHPAD_VERSION=0.1.0

# --- Secrets ---------------------------------------------------------------
# All generated by install.sh. Regenerating any of them has consequences that
# differ enormously, so they are worth stating separately.

# Signs session cookies. At least 32 bytes or the platform refuses to start.
# Changing it invalidates every session — people sign in again, and that is all.
JWT_SECRET=

# Encrypts app secrets and git tokens at rest. Exactly 64 hex characters.
# Replacing it *without keeping the old one below* destroys access to everything
# already encrypted. That is not silent any more — the platform starts and says
# in one line how many stored secrets it cannot read, and of which kinds — but it
# is still unrecoverable, because nothing but the old key can open them.
ENCRYPTION_KEY=

# Keys kept only for READING, comma-separated. Empty except for the length of a
# rotation, which is two steps and neither one is a migration:
#
#   1. Put the new key in ENCRYPTION_KEY, move the current one to this line, and
#      `docker compose up -d`. Every record names the key that wrote it, so from
#      that moment new writes use the new key and everything already stored still
#      reads. Nothing is down and nothing is rewritten.
#   2. `docker compose exec launchpad launchpad rotate-key` re-encrypts what is
#      left. It surveys first and refuses to begin if any record was written
#      under a key that is in neither variable, rather than sweeping half the
#      estate. Safe to interrupt, safe to run twice, and `--dry-run` reports what
#      is stored under which key without changing anything.
#
# Then empty this line and restart — and not before it reports nothing left under
# the old key. Retiring a key is not revoking it: dropping one whose records still
# exist destroys them.
ENCRYPTION_KEY_OLD=

# The bundled database's password. Changing it needs the database changed too.
POSTGRES_PASSWORD=

# The built-in administrator's FIRST password, read exactly once — a boot that
# finds the account already has a password ignores this entirely. install.sh
# removes the line after the first successful boot, because by then it has been
# read and printed and is no longer a credential, only a stale string.
#
# Empty, on an install that has never booted, means the server generates one and
# prints it once in a FIRST BOOT banner in the log. Either way the first sign-in
# must replace it: it mints no session, only the chance to choose a real one.
#
# Lost it? This needs no old password, only a shell on this machine:
#   docker compose exec launchpad launchpad local-admin enable
BOOTSTRAP_ADMIN_PASSWORD=

# --- How it is reached -----------------------------------------------------

# The platform's origin. Deployed apps are derived from it, on the apps port:
# http://localhost:8081. Both are published to loopback only and reached over an
# SSH tunnel.
#
# `localhost` is doing real work here. Session cookies always carry the Secure
# flag, and browsers treat localhost as a secure context — so they are stored
# over plain http. Point this at a LAN address over http and they are silently
# discarded: sign-in appears to work, and does not. Moving to a real hostname
# means TLS in front, this value changed, and the proxy added to
# TRUSTED_PROXY_CIDRS.
BASE_URL=http://localhost:8080

# The apps origin, stated rather than derived. Leave it empty and the platform
# builds it from BASE_URL's host and the apps *container* port — http://localhost:8081
# — which is correct for every tunnelled install, whatever host ports this
# machine had free.
#
# Set it only when the browser reaches the published host ports directly and
# they are not 8080/8081: on a laptop, or under WSL, where there is no tunnel to
# map them back. Then both of these move together, or app links point at a port
# nothing is listening on:
#   BASE_URL=http://localhost:9080
#   APPS_BASE_URL=http://localhost:9081
APPS_BASE_URL=

# The host side of the two published ports. Moved only when this machine already
# runs something on 8080 or 8081 — install.sh picks the next free pair and
# records it here. The container always listens on 8080 and 8081, and BASE_URL
# above is unaffected: it describes the browser's origin at the far end of the
# tunnel, so `ssh -L 8080:localhost:9080` keeps it true.
HOST_PLATFORM_PORT=8080
HOST_APPS_PORT=8081

# Extra browser origins trusted for write requests, comma-separated.
#
# Needed only when your SSH tunnel cannot use the same port numbers on both
# ends. `ssh -L 9090:localhost:8080` makes the browser's origin
# http://localhost:9090, which does not match BASE_URL — reads work and every
# write returns a bare 403 that looks like a broken button. Then set:
#   EXTRA_ORIGINS=http://localhost:9090
# Never add the apps origin (:8081) here. That is the origin being defended
# against.
EXTRA_ORIGINS=

# --- Optional --------------------------------------------------------------

# Logging. Both have working defaults and neither needs setting.
#
# The platform writes one structured stream to stdout — the container log, kept
# at 30 MB by compose.yml and nowhere else. Every request appears in it once, as
# a line carrying `kind=access` with the caller, the route, the status and the
# address; that is the only record of who *read* something, since the audit log
# in the database records only what people changed.
#
#   docker compose logs -f launchpad | jq 'select(.kind == "access")'
#
# So: if this install has to be able to answer who read what last month, point a
# log agent at the container's stdout. Thirty megabytes is hours on a busy
# install, and nothing here ships it anywhere.
#
# LOG_FORMAT=json     # json (default here) or text
# LOG_LEVEL=info      # debug, info, warn, error. warn silences ordinary
#                     # requests and keeps 5xx, which are logged at error.

# A proxy for the platform's OWN outbound calls: the gallery catalog, an OIDC
# issuer, Slack, advisory feeds.
#
# Builds do not inherit it. git, npm, uv and go are spawned with an allow-list
# environment that excludes these on purpose — a proxy URL often carries
# credentials, and every deployed app would be handed them. So an install behind
# a mandatory proxy can run the platform but cannot yet build an app.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,postgres

# Set by install.sh when it finds a cloud metadata endpoint, so that deployed
# apps cannot read the instance role's credentials. The capability and the
# variable live together in compose.metadata.yml, because either one alone is a
# container that refuses to start.
# COMPOSE_FILE=compose.yml:compose.metadata.yml
